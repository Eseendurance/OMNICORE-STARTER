# Copy this file to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Nothing below is required to run the starter — the app ships with mock
# data in lib/data.ts so you can deploy immediately and wire these in later.

# ── Search (Layer 3: /explore) ─────────────────────────────────────────
# app/api/search/route.ts currently searches the in-memory mock catalog.
# Swap in a real index when you have real product data:
#   Meilisearch Cloud free tier: https://www.meilisearch.com/pricing (Free plan)
#   Typesense Cloud free trial:  https://cloud.typesense.org
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# ── WhatsApp commerce bridge ────────────────────────────────────────────
# Meta WhatsApp Business Cloud API — infrastructure is free; customer-
# initiated "service" replies (like order/waybill updates a buyer asks
# about) are free and unlimited. Vendor-initiated template messages
# (marketing/utility/auth) are billed per message — check Meta's current
# rate card before relying on those. Create an app at:
#   https://developers.facebook.com/apps
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── SMS notifications (waybill / dispatch updates) ─────────────────────
# Termii — Nigeria-focused SMS, free trial credit on signup:
#   https://termii.com
TERMII_API_KEY=
TERMII_SENDER_ID=KiVo

# ── Product image processing ────────────────────────────────────────────
# Background removal runs locally in the browser using the open-source
# @imgly/background-removal package. No background-removal API key is needed.

# ── Marketplace base URL (used by CTA buttons on the separate SaaS landing site) ─
NEXT_PUBLIC_MARKETPLACE_URL=https://platform-gamma-neon.vercel.app

# ── Courier rate & label APIs (automated courier logistics) ────────────
# Terminal Africa — free sandbox endpoint (sandbox.terminal.africa) with
# test keys (sk_test_...), no card required. Get keys at:
#   https://terminal.africa
TERMINAL_AFRICA_API_KEY=
# Sendstack — request a sandbox key from their dashboard:
#   https://sendstack.africa
SENDSTACK_API_KEY=

# ── Realtime (live viewer counts, live-proof widget) ────────────────────
# Supabase free tier includes Realtime channels:
#   https://supabase.com/pricing
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Live streaming ("Go Live" on vendor storefronts/reels) ──────────────
# Agora RTC — free tier: 10,000 minutes/month, auto-enabled on new
# projects (no card required to start). Create a project at:
#   https://console.agora.io
# App ID is public (safe in NEXT_PUBLIC_*); App Certificate is secret —
# never expose it client-side, it's only used server-side in
# app/api/live/token/route.ts to sign short-lived viewer/host tokens.
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ── Site URL (required for email confirmation links to redirect correctly) ──
# Local dev: http://localhost:3000
# Production: your real deployed domain, e.g. https://platform-gamma-neon.vercel.app
NEXT_PUBLIC_SITE_URL=https://platform-gamma-neon.vercel.app

# ── Payments ─────────────────────────────────────────────────────────────
# Paystack — free to integrate, they take a per-transaction fee only:
#   https://paystack.com
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
