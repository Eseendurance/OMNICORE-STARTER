{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/store/layout,_N_T_/store/[vendor]/layout,_N_T_/store/[vendor]/page,_N_T_/store/lagos-fit"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/store/$d$vendor/__PAGE__",
    "/store/$d$vendor",
    "/store",
    "/_index",
    "/_head"
  ]
}